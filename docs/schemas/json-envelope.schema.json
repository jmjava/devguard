{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devguard.local/schemas/json-envelope.schema.json",
  "title": "DevGuard JSON envelope",
  "type": "object",
  "required": ["schema_version", "command", "observed_at", "ok"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "command": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "ok": { "type": "boolean" },
    "data": true,
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": { "type": "string" }
  },
  "additionalProperties": false
}
